<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface_card"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/ripple">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Status indicator dot -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle_green">

            <ImageView
                android:id="@+id/ivDeviceIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_device_connected"
                android:contentDescription="Device status" />
        </FrameLayout>

        <!-- Device Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device 1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvDeviceBroker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="tcp://broker.emqx.io:1883"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Topic Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_chip_status"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginTop="6dp">

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="@drawable/bg_icon_circle_green_small" />

                <TextView
                    android:id="@+id/tvDeviceTopic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="smartfarm/#"
                    android:textSize="10sp"
                    android:textColor="@color/primary_variant"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Edit Button -->
            <ImageView
                android:id="@+id/btnEditDevice"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_edit"
                android:contentDescription="Edit device"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_hint" />

            <!-- Delete Button -->
            <ImageView
                android:id="@+id/btnDeleteDevice"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_delete"
                android:contentDescription="Hapus device"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/status_danger"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
