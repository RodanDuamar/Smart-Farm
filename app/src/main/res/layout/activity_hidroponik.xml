<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9F5"
    tools:context=".hidroponik.HidroponikActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ==================== HEADER SECTION ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_header_gradient"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- App Logo Icon -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_circle_blue">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_hydroponics"
                    android:contentDescription="Hidroponik Logo" />
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Hidroponik"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#00695C"
                android:layout_marginTop="12dp" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistem IoT &amp; Solar Powered"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ==================== CONTENT SECTION ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ============ CARD: Nutrisi Air (PPM) ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/labelNutrisiAir"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nutrisi Air (PPM)"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true" />

                    <!-- Icon -->
                    <FrameLayout
                        android:id="@+id/iconKelembapan"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:background="@drawable/bg_icon_circle_green">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_water_drop"
                            android:contentDescription="Moisture Icon" />
                    </FrameLayout>

                    <!-- Value -->
                    <LinearLayout
                        android:id="@+id/valueNutrisiAir"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/labelNutrisiAir"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:baselineAligned="true">

                        <TextView
                            android:id="@+id/tvNutrisiAir"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="65"
                            android:textSize="40sp"
                            android:textStyle="bold"
                            android:textColor="#1B1F1B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" %"
                            android:textSize="18sp"
                            android:textColor="#757575" />
                    </LinearLayout>

                    <!-- Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progressNutrisiAir"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_below="@id/valueNutrisiAir"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progress="65"
                        android:progressDrawable="@drawable/progress_bar_green" />

                    <!-- Scale labels -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/progressNutrisiAir"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="0"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp" />

                        <!-- Optimal indicator -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_icon_circle_green" />

                            <TextView
                                android:id="@+id/tvStatusNutrisiAir"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Optimal"
                                android:textColor="#4CAF50"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="100"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp" />
                    </RelativeLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ CARD: pH Larutan ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/labelLarutan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="pH Larutan"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true" />

                    <!-- Icon -->
                    <FrameLayout
                        android:id="@+id/iconLarutan"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:background="@drawable/bg_icon_circle_purple">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_flask"
                            android:contentDescription="pH Icon" />
                    </FrameLayout>

                    <!-- Value -->
                    <TextView
                        android:id="@+id/tvLarutan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/labelLarutan"
                        android:layout_marginTop="8dp"
                        android:text="6.5"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:textColor="#1B1F1B" />

                    <!-- Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progressLarutan"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_below="@id/tvLarutan"
                        android:layout_marginTop="12dp"
                        android:max="140"
                        android:progress="65"
                        android:progressDrawable="@drawable/progress_bar_green" />

                    <!-- Scale labels -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/progressLarutan"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="12sp"
                            android:textColor="#9E9E9E"
                            android:layout_alignParentStart="true" />

                        <!-- Optimal indicator -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_icon_circle_green" />

                            <TextView
                                android:id="@+id/tvStatusLarutan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Optimal"
                                android:textSize="12sp"
                                android:textColor="#4CAF50"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14"
                            android:textSize="12sp"
                            android:textColor="#9E9E9E"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>



            <!-- ============ CARD: Valve Input Cairan ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Card Header -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_icon_circle_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Valve Input Cairan"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1B1F1B"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginBottom="8dp" />

                    <!-- ====== Pompa Air Row ====== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle_blue">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_water_drop_blue"
                                android:contentDescription="Water Icon" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pompa Air"
                            android:textSize="15sp"
                            android:textColor="#424242"
                            android:layout_marginStart="12dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchPompaAir"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- ====== Pompa Nutrisi Row ====== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle_orange">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_add_circle"
                                android:contentDescription="Insecticide Icon" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pompa Nutrisi"
                            android:textSize="15sp"
                            android:textColor="#424242"
                            android:layout_marginStart="12dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchPompaNutrisi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>




                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>