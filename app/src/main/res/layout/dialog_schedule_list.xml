<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvDialogListTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jadwal Kran Air"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1B5E20"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvDialogListSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kelola jadwal penyiraman"
        android:textSize="13sp"
        android:textColor="#757575"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="12dp" />

    <!-- Schedule List Container (items added programmatically) -->
    <LinearLayout
        android:id="@+id/layoutScheduleList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅"
            android:textSize="36sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Belum ada jadwal"
            android:textSize="14sp"
            android:textColor="#9E9E9E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tekan tombol di bawah untuk menambah jadwal baru"
            android:textSize="12sp"
            android:textColor="#BDBDBD"
            android:gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Add Schedule Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddSchedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="＋ Tambah Jadwal"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp"
        app:backgroundTint="#4CAF50"
        app:cornerRadius="8dp"
        app:icon="@android:drawable/ic_input_add"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF" />

    <!-- Info text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Anda dapat menambah beberapa jadwal berbeda untuk valve ini. Pompa otomatis menyala saat valve aktif."
        android:textSize="11sp"
        android:textColor="#9E9E9E"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp" />

</LinearLayout>
