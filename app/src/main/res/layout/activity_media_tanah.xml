<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9F5"
    tools:context=".mediatanah.MediaTanahActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ==================== HEADER SECTION ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_header_gradient"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- App Logo Icon -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_circle_green">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_app_logo"
                    android:contentDescription="App Logo" />
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Irrigation"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:layout_marginTop="12dp" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistem IoT &amp; Solar Powered"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ==================== CONTENT SECTION ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ============ CARD: Kelembapan Tanah ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/labelKelembapan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kelembapan Tanah"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true" />

                    <!-- Icon -->
                    <FrameLayout
                        android:id="@+id/iconKelembapan"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:background="@drawable/bg_icon_circle_green">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_water_drop"
                            android:contentDescription="Moisture Icon" />
                    </FrameLayout>

                    <!-- Value -->
                    <LinearLayout
                        android:id="@+id/valueKelembapan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/labelKelembapan"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:baselineAligned="true">

                        <TextView
                            android:id="@+id/tvKelembapan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="65"
                            android:textSize="40sp"
                            android:textStyle="bold"
                            android:textColor="#1B1F1B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" %"
                            android:textSize="18sp"
                            android:textColor="#757575" />
                    </LinearLayout>

                    <!-- Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progressKelembapan"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_below="@id/valueKelembapan"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progress="65"
                        android:progressDrawable="@drawable/progress_bar_green" />

                    <!-- Scale labels -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/progressKelembapan"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="12sp"
                            android:textColor="#9E9E9E"
                            android:layout_alignParentStart="true" />

                        <!-- Optimal indicator -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_icon_circle_green" />

                            <TextView
                                android:id="@+id/tvStatusKelembapan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Optimal"
                                android:textSize="12sp"
                                android:textColor="#4CAF50"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100"
                            android:textSize="12sp"
                            android:textColor="#9E9E9E"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ CARD: pH Tanah ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/labelPH"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="pH Tanah"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true" />

                    <!-- Icon -->
                    <FrameLayout
                        android:id="@+id/iconPH"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:background="@drawable/bg_icon_circle_purple">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_flask"
                            android:contentDescription="pH Icon" />
                    </FrameLayout>

                    <!-- Value -->
                    <TextView
                        android:id="@+id/tvPH"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/labelPH"
                        android:layout_marginTop="8dp"
                        android:text="6.5"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:textColor="#1B1F1B" />

                    <!-- Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progressPH"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_below="@id/tvPH"
                        android:layout_marginTop="12dp"
                        android:max="140"
                        android:progress="65"
                        android:progressDrawable="@drawable/progress_bar_green" />

                    <!-- Scale labels -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/progressPH"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="12sp"
                            android:textColor="#9E9E9E"
                            android:layout_alignParentStart="true" />

                        <!-- Optimal indicator -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_icon_circle_green" />

                            <TextView
                                android:id="@+id/tvStatusPH"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Optimal"
                                android:textSize="12sp"
                                android:textColor="#4CAF50"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14"
                            android:textSize="12sp"
                            android:textColor="#9E9E9E"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ CARD: Sumber Daya ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/labelSumberDaya"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sumber Daya Utama"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true" />

                    <!-- Icon -->
                    <FrameLayout
                        android:id="@+id/iconSumberDaya"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:background="@drawable/bg_icon_circle_orange">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_lock_power_off"
                            android:contentDescription="Power Source Icon" />
                    </FrameLayout>

                    <!-- Switch Control -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/labelSumberDaya"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Listrik Rumah"
                            android:textAlignment="viewEnd"
                            android:textSize="14sp"
                            android:textColor="#424242"
                            android:layout_marginEnd="12dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchSumberDaya"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Panel Surya"
                            android:textSize="14sp"
                            android:textColor="#424242"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ CARD: Valve Input Cairan ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Card Header -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_icon_circle_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Valve Input Cairan"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1B1F1B"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginBottom="8dp" />

                    <!-- ====== Kran Air Row ====== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle_blue">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_water_drop_blue"
                                android:contentDescription="Water Icon" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight=" 1"
                            android:text="Kran Air"
                            android:textSize="15sp"
                            android:textColor="#424242"
                            android:layout_marginStart="12dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchKranAir"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- ====== Kran Insektisida Row ====== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle_orange">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_add_circle"
                                android:contentDescription="Insecticide Icon" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Kran Insektisida"
                            android:textSize="15sp"
                            android:textColor="#424242"
                            android:layout_marginStart="12dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchKranInsektisida"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- ====== Kran Pupuk Row ====== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle_green_small">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_fertilizer"
                                android:contentDescription="Fertilizer Icon" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Kran Pupuk"
                            android:textSize="15sp"
                            android:textColor="#424242"
                            android:layout_marginStart="12dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchKranPupuk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- ====== Kran Daya Row ====== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle_blue">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_lock_power_off"
                                android:contentDescription="Power Icon" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Daya"
                            android:textSize="15sp"
                            android:textColor="#424242"
                            android:layout_marginStart="12dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchDaya"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- ====== Kran Pembuangan Row ====== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle_blue">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_delete"
                                android:contentDescription="Waste Icon" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Kran Pembuangan"
                            android:textSize="15sp"
                            android:textColor="#424242"
                            android:layout_marginStart="12dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchKranPembuangan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>